// schema.prisma (en tu nueva rama)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AiScript {
  id                String   @id @default(uuid())
  title             String
  
  // Datos del Curso y Docente
  courseName        String
  teacherName       String
  teacherRole       String   // Cargo
  teacherSpecialty  String   // Especialidad
  
  // Contexto Pedagógico y Estilo
  studentProfile    String   // Perfil del Estudiante
  videoType         String   // Tipo de video
  tone              String   // Ej: formal, cercano
  style             String   // Estilo visual
  
  // Synthesia Integration
  templateId        String   
  templateName      String?  // Nombre del template de Synthesia
  templateData      Json     // JSONB para variables dinámicas
  rawTemplateVariables Json? // Variables "crudas" del template para referencia futura
  sourceContent     String?  @db.Text // Contenido extraído de los archivos PDF/DOCX
  isDeleted         Boolean  @default(false)
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  videos            VideoRender[]
}

model VideoRender {
  id              String      @id @default(uuid())
  externalId      String?     @unique // ID de Synthesia
  status          String      @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  
  scriptId        String
  script          AiScript    @relation(fields: [scriptId], references: [id])

  isDeleted       Boolean     @default(false)
  
  // No guardamos URL fija, se pedirá a la API vía externalId
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}