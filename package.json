{
  "name": "course-builder",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=@course-builder/*",
    "dev": "turbo run dev --filter=@course-builder/*",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@types/multer": "^2.0.0",
    "@types/pdf-parse": "^1.1.5",
    "prettier": "^3.0.0",
    "turbo": "latest",
    "typescript": "^5.0.0"
  },
  "packageManager": "npm@11.6.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.26.3",
    "@aws-sdk/client-bedrock-runtime": "^3.989.0",
    "@aws-sdk/client-s3": "^3.971.0",
    "dotenv": "^17.2.3",
    "mammoth": "^1.11.0",
    "pdf-parse": "^2.4.5"
  },
  "overrides": {
    "glob": "^10.3.10",
    "inquirer": "^9.0.0"
  }
}
